{
  "name": "wpa-be-bible-proxy",
  "version": "1.0.0",
  "description": "WPA BE Bible Proxy: authenticated caching proxy between the WPA BE app and API.Bible",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.4.1",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.0",
    "ioredis": "^5.11.1",
    "lru-cache": "^11.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  }
}
