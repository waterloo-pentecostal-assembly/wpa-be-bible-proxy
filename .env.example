# =============================================================================
# WPA BE Bible Proxy configuration
#
#   cp .env.example .env      (.env is gitignored; never commit real keys)
#
# Read automatically by `npm run dev`, `npm start` and `docker compose up`.
# In production, set these as real env vars, with API_BIBLE_KEYS in a secret manager.
#
# Legend:  [REQUIRED]     must be set or the service will not start / will reject everyone
#          [RECOMMENDED]  set for production, depending on your setup
#          everything else shows its default; delete the line or leave it as-is
# =============================================================================


# -----------------------------------------------------------------------------
# [REQUIRED] YOU MUST FILL THESE IN
# -----------------------------------------------------------------------------

# [REQUIRED] API.Bible key(s) from https://api.bible (your app's dashboard).
# Comma-separated: the first is primary, the rest are failover / rotation.
API_BIBLE_KEYS=replace-with-your-api-bible-key

# [REQUIRED] Firebase is configured with files in src/config/ (same layout as wpa-be-admin),
# not env vars:
#   src/config/service-account.json        prod service account key
#   src/config/service-account-dev.json    dev service account key
#       (Firebase console → Project settings → Service accounts → Generate new private key)
#   src/config/firebase-client-config.json prod web config: the /debug console signs in with it
# The files are gitignored. Users of each service account's project may call the proxy, and
# the accounts power the admin checks (Firestore users/{uid}.is_admin).
# In deployments, mount the same files at /etc/secrets/ instead (checked first), or pass the
# JSON in FIREBASE_SERVICE_ACCOUNT / FIREBASE_SERVICE_ACCOUNT_DEV / FIREBASE_CLIENT_CONFIG.

# Only this project's admins may use /admin and the /debug console. Defaults to the prod service
# account's project (e.g. wpa-be-app). Users of every accepted project can still call /v1.
# FIREBASE_ADMIN_PROJECT_ID=

# Only for extra projects without a service account file: comma-separated project IDs whose
# users may also call the proxy (admin checks for them need Application Default Credentials).
# FIREBASE_PROJECT_IDS=


# -----------------------------------------------------------------------------
# [RECOMMENDED] Depends on your setup
# -----------------------------------------------------------------------------

# [RECOMMENDED if you have a web client] Browser origins allowed to call the proxy.
# Comma-separated. Unset = CORS disabled (fine for mobile-only). "*" = any origin.
# CORS_ORIGINS=https://app.example.com,http://localhost:5173

# [RECOMMENDED if you run more than one instance] Shared cache + shared rate limits.
# Unset = per-instance in-memory cache only.
# REDIS_URL=redis://localhost:6379

# [RECOMMENDED: check this] Set to true if your app uses Firebase Anonymous Auth,
# otherwise anonymous users get 403.
ALLOW_ANONYMOUS_USERS=false


# -----------------------------------------------------------------------------
# Authentication / security (defaults shown)
# -----------------------------------------------------------------------------

# true = also reject revoked sessions and disabled users immediately.
# Costs one Firebase call per request and needs Google credentials with Firebase Auth
# access in every project above. false = a disabled user keeps access until their token
# expires (max 1 hour).
FIREBASE_CHECK_REVOKED=false

# true = clients must also send X-Firebase-AppCheck (proves the call comes from your app).
FIREBASE_REQUIRE_APP_CHECK=false


# -----------------------------------------------------------------------------
# Abuse protection: per Firebase user, per minute (defaults shown)
# -----------------------------------------------------------------------------

# All requests, including cache hits.
RATE_LIMIT_REQUESTS_PER_MINUTE=300

# Only requests that miss the cache and cost an API.Bible call.
# Lower this on the Starter plan (5,000 calls/month).
RATE_LIMIT_UPSTREAM_PER_MINUTE=30


# -----------------------------------------------------------------------------
# Cache (defaults shown)
# Every TTL is clamped to 29 days (2505600 s), as required by API.Bible Terms §11.
# -----------------------------------------------------------------------------

# Verses, chapters, passages, sections: 7 days
CACHE_TTL_CONTENT_SECONDS=604800

# Lists of bibles / books / chapters / verses: 1 day
CACHE_TTL_METADATA_SECONDS=86400

# Search results: 1 day
CACHE_TTL_SEARCH_SECONDS=86400

# Upstream 400/403/404 results: 10 minutes
CACHE_TTL_NEGATIVE_SECONDS=600

# How old a cached copy may be and still be served when API.Bible is down or out of quota.
CACHE_STALE_IF_ERROR_SECONDS=2505600

# How long clients may cache responses on their side (Cache-Control max-age).
CLIENT_MAX_AGE_SECONDS=3600

# In-process memory cache size per instance.
MEMORY_CACHE_MAX_MB=128

# With Redis enabled: max lifetime of an entry in each instance's memory cache. Purges
# reach every instance within this time.
MEMORY_CACHE_MAX_TTL_SECONDS=3600

# Namespace for Redis keys (useful if dev and prod share one Redis).
REDIS_KEY_PREFIX=bible-proxy:


# -----------------------------------------------------------------------------
# Server / upstream (defaults shown)
# -----------------------------------------------------------------------------

# Render sets PORT itself; don't set it there.
PORT=8080
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# true when running behind a load balancer / Render / Cloud Run (correct client IPs in logs).
TRUST_PROXY=true

# Timeout for each API.Bible request.
UPSTREAM_TIMEOUT_MS=10000

# Only change this if API.Bible moves its API.
API_BIBLE_BASE_URL=https://rest.api.bible/v1
